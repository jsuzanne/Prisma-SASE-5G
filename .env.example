# Prisma Access 5G SASE Environment Configuration

# --- PANW Strata Cloud Manager / SASE OAuth2 Service Account Credentials ---
# In Strata Cloud Manager (SCM), create a Service Account with appropriate roles (Auditor or Superuser / SASE admin).
PANW_CLIENT_ID=your_client_id_here
PANW_CLIENT_SECRET=your_client_secret_here
PANW_TSG_ID=your_tsg_id_here

# --- Optional: Static Bearer Token (if using pre-generated access token) ---
# If provided, the client will use this token directly instead of fetching via OAuth2.
# PANW_AUTH_TOKEN=your_bearer_token_here

# --- Palo Alto Networks Cloud Endpoints ---
# Management API Base URL (Prisma SASE / Strata Cloud Manager API Gateway)
PANW_API_BASE_URL=https://api.sase.paloaltonetworks.com

# PANW OAuth2 Token URL
PANW_AUTH_URL=https://auth.apps.paloaltonetworks.com/am/oauth2/access_token

# --- Defaults for 5G Subscriber / SIM Management ---
DEFAULT_APN=sasetest
DEFAULT_IP_TYPE=IPv4

# --- Live API Inspector & Debug Logger ---
# In-memory transaction ring-buffer size (default: 150, range: 10-1000)
API_DEBUG_BUFFER_SIZE=150

